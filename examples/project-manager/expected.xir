experience ProjectManager {
  goal: "Help teams organize and execute work."
  version: 1

  requirement requirement {
    claim: "Members must confirm destructive project actions."
  }
  decision decision {
    claim: "Project archiving lives in the project overflow menu."
  }
  inference archiveLocation {
    claim: "Archive belongs in the project overflow menu."
    confidence: probable
    evidence { screenshot.dashboard analytics.archiveUsage design.decision.D14 }
  }
  goal createProject {
    description: "Create a new project."
    actor: actor.member
  }
  permission project.read {
    description: "View projects."
  }
  permission project.create {
    description: "Create projects."
  }
  permission project.archive {
    description: "Archive a project."
  }
  actor member {
    permissions { permission.project.read permission.project.create }
  }
  actor manager {
    permissions { permission.project.read permission.project.create permission.project.archive }
  }
  entity Project {
    id: ID
    name: Text
    status: draft | active | archived
  }
  entity Task {
    id: ID
    title: Text
    done: Bool
  }
  event ProjectCreated
  event ProjectArchived
  capability createProject {
    id: capability.createProject
    input { name: Text }
    output: entity.project
    requires: permission.project.create
    consumes: entity.project
    emits: event.projectCreated
  }
  capability archiveProject {
    id: capability.archiveProject
    input { project: Project }
    output: entity.project
    requires: permission.project.archive
    consumes: entity.project
    mutates { field.project.status }
    emits: event.projectArchived
    confirmation: required
    audit: required
  }
  interaction createProject {
    id: interaction.createProject
    trigger: click
    target: component.dashboard.createProjectButton
    invokes: capability.createProject
  }
  interaction archiveProject {
    id: interaction.archiveProject
    trigger: click
    target: component.projectDetail.archiveButton
    invokes: capability.archiveProject
  }
  interaction submitProject {
    id: interaction.submitProject
    trigger: click
    target: component.createProject.submitButton
    invokes: capability.createProject
  }
  component CreateProjectButton {
    id: component.dashboard.createProjectButton
    invokes: capability.createProject
  }
  component ArchiveButton {
    id: component.projectDetail.archiveButton
    presents: entity.project
    invokes: capability.archiveProject
    states { machine.projectDetailActions }
  }
  component ProjectList {
    id: component.dashboard.projectList
    presents: entity.project
    states { machine.projectList }
  }
  component SubmitButton {
    id: component.createProject.submitButton
    invokes: capability.createProject
  }
  component ProjectForm {
    id: component.projectForm
    presents: entity.project
  }
  state projectList {
    initial: loading
    loading {
      on dataReceived -> populated
      on emptyReceived -> empty
      on failure -> error
    }
    empty {
      on createProject -> loading
    }
    populated {
      on refresh -> refreshing
      on ProjectArchived -> refreshing
    }
    refreshing {
      on success -> populated
      on failure -> error
    }
    error {
      on retry -> loading
    }
  }
  state projectDetailActions {
    initial: enabled
    enabled {
      on archiveProject -> confirming
    }
    confirming {
      on confirm -> archived
      on cancel -> enabled
      on failure -> error
    }
    archived {
      on reset -> enabled
    }
    error {
      on retry -> enabled
    }
  }
  state projectCreation {
    initial: validating
    validating {
      on success -> created
      on invalid -> invalid
      on networkError -> error
    }
    created {
      on reset -> validating
    }
    invalid {
      on retry -> validating
    }
    error {
      on retry -> validating
    }
  }
  surface Dashboard {
    id: surface.dashboard
    presents: entity.project
    components { Sidebar Main Header ProjectList CreateProjectButton }
  }
  surface ProjectDetail {
    id: surface.projectDetail
    presents: entity.project
    components { Header ProjectOverview TaskList ArchiveButton }
  }
  surface CreateProject {
    id: surface.createProject
    presents: entity.project
    components { ProjectForm SubmitButton }
  }
  flow CreateProject {
    id: flow.createProject
    goal: goal.createProject
    actor: actor.member
    entry { surface: surface.dashboard }
    step openForm {
      from: surface.dashboard
      action: interaction.createProject
      to: surface.createProject
    }
    step submit {
      from: surface.createProject
      action: interaction.submitProject
      to: state.projectCreation.validating
    }
    branch validation {
      from: state.projectCreation.validating
      success -> entity.project
      invalid -> state.projectCreation.invalid
      networkError -> state.projectCreation.error
    }
  }
  invariant destructiveActionsRequireConf {
    rule: "destructive actions require confirmation"
    scope: capability.archiveProject
  }
  invariant unauthenticatedUsersCannotAcc {
    rule: "unauthenticated users cannot access Dashboard"
    scope: surface.dashboard
  }
}
