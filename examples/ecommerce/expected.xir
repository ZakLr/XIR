experience Shop {
  goal: "Sell goods."

  actor guest {
  }
  actor buyer {
  }
  actor admin {
  }
  entity Order {
    id: ID
    status: draft | active | archived
  }
  capability checkout {
    id: capability.checkout
    input { order: Order }
    output: entity.order
    confirmation: required
  }
  surface Storefront {
    id: surface.storefront
    presents: entity.order
    states: loading populated error
  }
  flow Checkout {
    id: flow.checkout
    actor: actor.buyer
    step StorefrontToCheckout {
      from: surface.storefront
    }
    step CheckoutToOrder {
      to: entity.order
    }
  }
}
