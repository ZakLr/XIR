experience Dashboard {
  goal: "Show metrics."

  actor viewer {
  }
  actor admin {
  }
  entity Metric {
    id: ID
    name: Text
  }
  capability refreshMetrics {
    id: capability.refreshMetrics
    input { metric: Metric }
    output: entity.metric
  }
  surface Overview {
    id: surface.overview
    presents: entity.metric
    states: loading populated error
  }
  flow Refresh {
    id: flow.refresh
    actor: actor.viewer
    step OverviewToRefresh {
      from: surface.overview
    }
    step RefreshToMetric {
      to: entity.metric
    }
  }
}
