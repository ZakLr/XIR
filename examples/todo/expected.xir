experience Todo {
  goal: "Track tasks."

  actor user {
  }
  entity Todo {
    id: ID
    title: Text
    done: Bool
  }
  capability addTodo {
    id: capability.addTodo
    input { title: Text }
    output: entity.todo
  }
  capability completeTodo {
    id: capability.completeTodo
    input { todo: Todo }
    mutates { field.todo.done }
  }
  surface Main {
    id: surface.main
    presents: entity.todo
    states: loading empty populated error
  }
  flow AddTodo {
    id: flow.addTodo
    actor: actor.user
    step MainToAddTodo {
      from: surface.main
    }
    step AddTodoToTodo {
      to: entity.todo
    }
  }
}
